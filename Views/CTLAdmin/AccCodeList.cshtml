@{
    ViewData["Title"] = "Account code configuration";
}

@section PageStyles {
    <link href="~/css/datatables.min.css" rel="stylesheet" />
    <link href="~/css/datatables.css" rel="stylesheet" />
    <link href="~/css/acccodelist.css" rel="stylesheet" />
    <link href="~/css/bt-theme.css" rel="stylesheet" />
}

<div class="card bt-card mb-4">
    <div class="bt-page-header">
        <h5><i class="ri-list-settings-line"></i> Account code configuration</h5>
        <input type="hidden" id="adminRole" value="@ViewData["UROLEADMIN"]" />
    </div>

    <div class="bt-form-panel" id="spanAdmin" style="display:none">
        <div class="bt-form-panel-label">Add / edit account code</div>
        <div class="row">
            <div class="col-md-3">
                <input class="form-control" type="hidden" id="accMainTmp" />
                <input class="form-control" type="text" id="accMain" placeholder="* Acc Main" />
            </div>
            <div class="col-md-3">
                <input class="form-control" type="text" id="accName" placeholder="* Acc Name" />
            </div>
            <div class="col-md-2">
                <input class="form-control" type="text" id="accType" placeholder="Acc Type" />
            </div>
            <div class="col-md-2">
                <input class="form-control" type="text" id="accCategory" placeholder="Acc Cat." />
            </div>
            <div class="col-md-2 d-flex align-items-center gap-3">
                <button class="btn btn-bt-primary" type="button" id="btnSubmit">Add +</button>
                <div class="bt-action-icons">
                    <i id="btnAccEdit" class="ri-save-3-fill text-success" onclick="javascript:SaveEditAccount();" style="display:block" title="Edit"></i>
                    <i id="btnAccDel" class="ri-delete-bin-2-fill text-danger" onclick="javascript:DeleteAccount();" style="display:block" title="Delete"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive text-nowrap">
        <table id="bindDataTable" class="table table-hover" width="100%">
            <caption class="visually-hidden">Account code configuration</caption>
            <thead>
                <tr>
                    <th>Acc Main</th>
                    <th>Acc Name</th>
                    <th>Acc Type</th>
                    <th>Category</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- User permission warning modal -->
<div class="modal fade" id="modalAuth" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="authwarning" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="authwarning">User Permission</h5>
            </div>
            <div class="modal-body">
                You don't have this permission
            </div>
            <div class="modal-footer">
                <button type="button" id="btnModalClose" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/js/jquery.js"></script>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/acccodelist.js?v=1.0.4"></script>
}

    <!-- Add PR Detail -->
    <div class="card bg-body" id="card-detail">
      <h6 class="card-header text-start text-danger">Add Items Detail *ช่องที่จะต้องใส่ BT No., Description/Spec, ACC Code, Cost Dept, Quantity, Unit</h6>
      <div class="card-body">
        <div class="row mb-3">
          <div class="col-md-4">
              <div class="form-floating form-floating-outline mb-6">
                <input class="form-control custom-number-btinfo" list="opt_btnumber" id="item_btnumber" name="item_btnumber" placeholder="* Search BT. Items">
                <datalist name="opt_btnumber" id="opt_btnumber">
                  @{
                            if (modelItemsParts != null)
                            {
                                foreach (var rowBtItem in modelItemsParts)
                                {
                                    <option value="@rowBtItem.itemno : @rowBtItem.itemname">@rowBtItem.itemname</option>
                                }
                            }
                        }
                    </datalist>
                <label for="item_btnumber">* Search BT. Items</label>
              </div>
              @* <input class="form-control" type="text" placeholder='BT Number' id="item_btnumber" /> *@
          </div>
          <div class="col-md-8">
              @* <input class="form-control" type="text" id="item_descript" /> *@
              <div class="form-floating form-floating-outline mb-6">
                <textarea class="form-control" name="item_descript" id="item_descript" placeholder='* Description/Spec' rows="2"></textarea>
                <label for="item_descript">* Description/Spec</label>
              </div>
          </div>
        </div>
        <div class="row mb-3">
            
            <div class="col-md-8">
                <div class="form-floating form-floating-outline mb-6">
                  <input class="form-control" type="text" placeholder='Brand/Model' id="item_model" />
                  <label for="item_model">Brand/Model</label>
                </div>
            </div>

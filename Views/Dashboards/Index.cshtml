@{
    ViewData["Title"] = "BT Procure PR.Online";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/bt-theme.css" rel="stylesheet" />
}

@section PageScripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/datatables.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/index-dashboard.js?v=@DateTime.Now.ToString("ddmmmyyyyHHmmss")"></script>
}

<div class="card bt-card mb-4">
    <div class="bt-page-header">
        <h5><i class="ri-file-list-3-line"></i> My request</h5>
        <div class="bt-page-header-tag">
            <span id="cntDraft">0</span> draft &middot;
            <span id="cntActive">0</span> active &middot;
            <span id="cntApproved">0</span> completed
        </div>
    </div>
    <div class="table-responsive text-nowrap">
        <table id="bindDataTable" class="table table-hover" width="100%">
            <thead class="table-light">
                <tr>
                    <th class="col-hidden" style="display:none"></th>
                    <th>PR Information</th>
                    <th>PO Information</th>
                    <th>Remarks</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="card bt-card mb-4">
    <div class="bt-page-header">
        <h5><i class="ri-checkbox-circle-line"></i> My approve</h5>
    </div>
    <div class="table-responsive text-nowrap">
        <table id="bindDataTableApproval" class="table table-hover my-custom-table" width="100%">
            <thead class="table-light">
                <tr>
                    <th class="col-hidden" style="display:none"></th>
                    <th>PR Information</th>
                    <th>PO Information</th>
                    <th>Remarks</th>
                    <th>Approval Status</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

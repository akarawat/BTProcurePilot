@{
    var isFullscreen = ViewData["isFullscreen"]?.ToString() == "true";
    var navbarType = isFullscreen ? "layout-navbar-hidden" : "layout-navbar-fixed";
    var menuFixed = isFullscreen ? "" : "menu-fixed";
    var isNavbar = !isFullscreen;
    var isMenu = !isFullscreen;
    var strCaption = isFullscreen ? "Exit full screen" : "Full screen";
    ViewData["isMenu"] = isMenu;
    ViewData["menuFixed"] = menuFixed;
    ViewData["isNavbar"] = isNavbar;
    ViewData["navbarType"] = navbarType;
    ViewData["Title"] = "Procurement report";
}

@section PageStyles {
    <link href="~/css/datatables.min.css" rel="stylesheet" />
    <link href="~/css/datatables.css" rel="stylesheet" />
    <link href="~/css/usersetting.css" rel="stylesheet" />
    <link href="~/css/bt-theme.css" rel="stylesheet" />
}

<div class="card bt-card mb-4">
    <div class="bt-page-header">
        <h5><i class="ri-file-chart-2-line"></i> @ViewData["Title"]</h5>
        <button class="btn btn-success btn-sm" type="button" id="btnExport"><i class="ri-download-2-line"></i> Export</button>
    </div>

    <div class="bt-form-panel">
        <div class="row g-3">
            <div class="col-md-2">
                <div class="text-secondary small" id="id_lbl_all_pr"></div>
                <div class="h5 mb-0 bt-stat-link" style="color:var(--bt-primary)" id="id_all_pr" onclick="applyQuickFilter('all')">@ViewData["all_pr"]</div>
            </div>
            <div class="col-md-2">
                <div class="text-secondary small" id="id_lbl_completed"></div>
                <div class="h5 mb-0 bt-stat-link" style="color:var(--bt-primary)" id="id_completed" onclick="applyQuickFilter('completed')">@ViewData["completed"]</div>
            </div>
            <div class="col-md-2">
                <div class="text-secondary small" id="id_lbl_rfq"></div>
                <div class="h5 mb-0 bt-stat-link" style="color:var(--bt-primary)" id="id_rfq" onclick="applyQuickFilter('rfq')">@ViewData["rfqcount"] / @ViewData["rfqcount_quo"]</div>
                <h4 class="mb-0" id="lbl_perc" style="display:none"></h4>
            </div>
            <div class="col-md-3 d-flex align-items-center gap-2 bt-stat-link" onclick="applyQuickFilter('pending')">
                <i class="ri-group-line ri-24px text-secondary"></i>
                <div>
                    <div class="small text-secondary" id="id_lbl_inprocess"></div>
                    <div class="h6 mb-0" id="id_inprocess">@ViewData["inprocess"]</div>
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-center gap-2 bt-stat-link" onclick="applyQuickFilter('received')">
                <i class="ri-money-dollar-circle-line ri-24px text-secondary"></i>
                <div>
                    <div class="small text-secondary" id="id_lbl_procure_rec"></div>
                    <div class="h6 mb-0" id="id_procure_rec">@ViewData["procure_rec"]</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-3 pt-3 border-top">
            <div class="col-md-3">
                <label class="form-label small mb-1" for="filterDept">Department</label>
                <select id="filterDept" class="form-select form-select-sm">
                    <option value="">All departments</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="filterPRType">PR type</label>
                <select id="filterPRType" class="form-select form-select-sm">
                    <option value="">All types</option>
                    <option value="normal">Normal PR</option>
                    <option value="rfq">RFQ only</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="filterStatus">Status</label>
                <select id="filterStatus" class="form-select form-select-sm">
                    <option value="">All status</option>
                    <option value="pending">Pending approval (not yet at procurement)</option>
                    <option value="received">Procurement received</option>
                    <option value="completed">PR completed (PO issued)</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-outline-secondary btn-sm" type="button" id="btnFilterReset"><i class="ri-refresh-line"></i> Reset filters</button>
            </div>
        </div>
    </div>

    <div class="table-responsive text-nowrap">
        <table id="bindDataTable" class="table table-bordered table-hover" width="100%">
            <thead>
                <tr>
                    <th>PR Create</th>
                    <th>Date</th>
                    <th>PR No</th>
                    <th>Status</th>
                    <th>Approval 1</th>
                    <th>Approval 1/2</th>
                    <th>Manager</th>
                    <th>MD.</th>
                    <th>Discount</th>
                    <th>Total</th>
                    <th>Currency</th>
                    <th>Project No</th>
                    <th>Requester</th>
                    <th>Reason</th>
                    <th>Approx Date</th>
                    <th>Update Date</th>
                    <th>Proc.Receive</th>
                    <th>PO No</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="layout-demo-info">
    <button class="btn btn-outline-secondary" id="toggleFullscreenBtn">
        <i class="bx bx-fullscreen"></i> @strCaption
    </button>
</div>

<!-- User permission warning modal -->
<div class="modal fade" id="modalAuth" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="authwarning" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="authwarning">User Permission</h5>
            </div>
            <div class="modal-body">
                You don't have this permission
            </div>
            <div class="modal-footer">
                <button type="button" id="btnModalClose" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/js/jquery.js"></script>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/procurereport.js?v=@DateTime.Now.ToString("ddMMyyyyHHmmss")"></script>
    <script src="~/js/procurereport-filter.js?v=@DateTime.Now.ToString("ddMMyyyyHHmmss")"></script>
    <script src="~/js/xlsx.full.min.js"></script>
    <script src="~/js/jszip.min.js"></script>
}

@{
    var isFullscreen = ViewData["isFullscreen"]?.ToString() == "true";
    var navbarType = isFullscreen ? "layout-navbar-hidden" : "layout-navbar-fixed";
    var menuFixed = isFullscreen ? "" : "menu-fixed";
    var isNavbar = !isFullscreen;
    var isMenu = !isFullscreen;
    var strCaption = isFullscreen ? "Exit full screen" : "Full screen";
    ViewData["isMenu"] = isMenu;
    ViewData["menuFixed"] = menuFixed;
    ViewData["isNavbar"] = isNavbar;
    ViewData["navbarType"] = navbarType;
}
@{
    List<ProcureUserModel> modelProcure = Model.VMProcureUserModel ?? new List<ProcureUserModel>();
    List<VenModel> modelVen = Model.VMVenModel ?? new List<VenModel>();
    List<ProjModel> modelProj = Model.VMProjModel ?? new List<ProjModel>();
    List<AccModel> modelAcc = Model.VMAccModel ?? new List<AccModel>();
    List<CurrencyModel> modelCurrency = Model.VMCurrencyModel ?? new List<CurrencyModel>();

    ViewData["Title"] = "New Purchase Request";
    string sDOC_NUMBER = ViewData["DOC_NUMBER"]?.ToString() ?? string.Empty;
    string sEMPCODE = Context.Session.GetString(SessionModel.EMPCODE) ?? string.Empty;
    string sDEPCODE = Context.Session.GetString(SessionModel.DEPCODE) ?? string.Empty;
    string sUEMAIL = Context.Session.GetString(SessionModel.UEMAIL) ?? string.Empty;
}

@section PageStyles {
    <link href="~/css/datatables.min.css" rel="stylesheet" />
    <link href="~/css/datatables.css" rel="stylesheet" />
    <link href="~/css/prnewrequest.css" rel="stylesheet" />
    <link href="~/css/bt-theme.css" rel="stylesheet" />
}

<form method="post">
    <div class="card bt-card mb-4">
        <div class="bt-page-header">
            <h5><i class="ri-file-add-line"></i> New purchase request</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3 ms-auto">
                    <div class="form-check">
                        <input type="text" class="form-control form-control-sm border-danger" name="prno" id="prno" value="@sDOC_NUMBER" placeholder="PR Number (Auto running No.)" disabled>
                        <input type="hidden" name="prno_draft" id="prno_draft" value="@sDOC_NUMBER" />
                        <input type="hidden" name="empCode" id="empCode" value="@sEMPCODE" />
                        <input type="hidden" name="reqDepCode" id="reqDepCode" value="@sDEPCODE" />
                        <input type="hidden" name="prcurrency" id="prcurrency" />
                    </div>
                    <div class="form-check">
                        <label for="id_projno" class="form-label">Project Number</label>
                        <input class="form-control custom-number-btinfo" list="opt_projno" id="id_projno" name="id_projno" placeholder="Project Number" autocomplete="off">
                        <datalist name="opt_projno" id="opt_projno">
                            @foreach (var rowProj in modelProj)
                            {
                                <option value="@rowProj.ProjNo">@rowProj.ProjName</option>
                            }
                        </datalist>
                    </div>
                </div>
            </div>
            <div class="row">
                <!-- Approx require -->
                <div class="col-md-4 mb-3"></div>
                <div class="col-md-4 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="rdoApprox" id="rdoApprox" value="3">
                        <label class="form-check-label" for="rdoApprox">Urgent-PO issue after receive PR 3 working days</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="rdoApprox" id="rdoApprox2" value="1">
                        <label class="form-check-label" for="rdoApprox2">Normal-PO issue after receive PR 10 working days</label>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="form-check">
                        <label class="form-check-label text-danger" for="approx_dt">Require delivery date</label>
                        <input type="date" class="form-control form-control-sm" name="approx_dt" id="approx_dt">
                    </div>
                    <div class="form-check">
                        <input type="text" class="form-control form-control-sm" name="InvNo" id="InvNo"
                               placeholder="Investment request / Credit request No.">
                    </div>
                </div>
            </div>
            <div class="row">
                <!-- Purpose -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Purpose:</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="rdoPurpose" id="rdoPurpose1" value="1" checked="checked">
                        <label class="form-check-label" for="rdoPurpose1">Order external 365 system</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="rdoPurpose" id="rdoPurpose2" value="2">
                        <label class="form-check-label" for="rdoPurpose2">Order in the 365 system</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="rdoPurpose" id="rdoPurpose3" value="3">
                        <label class="form-check-label" for="rdoPurpose3">Request quotation only</label>
                    </div>
                </div>

                <!-- Reference -->
                <div class="col-md-4 mb-3">
                    <div class="row">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Reference:</label>
                            <input type="text" class="form-control" name="reference" id="reference" placeholder="Change No. / NCR No. / WO No. / Work Permit No.">
                        </div>
                        <!-- Reason to order -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-danger">* Reason to order:</label>
                            <textarea class="form-control" name="reason" id="reason" rows="2"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Area for purchaser -->
                <div class="col-md-4 mb-3">
                    <div class="border p-2 border-warning text-warning">
                        <strong>Area for purchaser use only</strong>
                        <div class="mb-2">
                            <label class="form-label small">PR Received date</label>
                            <input type="date" class="form-control form-control-sm" name="prReceivedDate" disabled="disabled">
                        </div>
                        <div>
                            <label class="form-label small">PO Number</label>
                            <input type="text" class="form-control form-control-sm" name="poNumber" disabled="disabled">
                        </div>
                    </div>
                </div>
            </div>
            <!-- Start Suggest Supplier 1 -->
            <div class="card bt-card" id="card-supp1" style="display:none">
                <h5 class="bt-subcard-header"><i class="ri-truck-line"></i> Suggested supplier</h5>
                <div class="card-body">
                    <div class="row mb-3 bg-transparent">
                        <div class="col-md-3 border-warning">
                            <input class="form-control custom-number-btinfo" list="opt_supp1" id="id_supp1" name="id_supp1" placeholder="Select Supplier">
                            <datalist name="opt_supp1" id="opt_supp1">
                                @foreach (var rowVen in modelVen)
                                {
                                    <option value="@rowVen.VenCode">[@rowVen.Vencurrency] @rowVen.VenName</option>
                                }
                            </datalist>
                        </div>

                        <div class="col-md-5">
                            <input type="text" class="form-control bg-transparent" name="name_supp1" id="name_supp1" placeholder="Supplier name (Option)">
                        </div>
                        <div class="col-md-2">
                        </div>
                        <div class="col-md-2">
                            <p class="text-end"><button class="btn btn-secondary" type="button" id="clearSupplier1" onclick="EmptySupplierData(1)">Clear</button></p>
                        </div>
                    </div>
                    <div class="row mb-3 bg-transparent">
                        <div class="col-md-3">
                            <input type="text" class="form-control bg-transparent" name="vc_supp1" id="vc_supp1" placeholder="V/C" style="display:none">
                            <input type="text" class="form-control" name="contact_supp1" id="contact_supp1" placeholder="Contact">
                        </div>
                        <div class="col-md-5">
                            <input type="email" class="form-control" name="email_supp1" id="email_supp1" placeholder="E-Mail">
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control" name="tel_supp1" id="tel_supp1" placeholder="Tel/Fax.">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <input type="text" class="form-control" name="remark_supp1" id="remark_supp1" placeholder="Remark.">
                            <input type="text" class="form-control" name="quoref_supp1" id="quoref_supp1" placeholder="Ref Quotation No." style="display:none">
                            <div class="form-floating form-floating-outline mb-6" style="display:none">
                                <input class="form-control" type="date" id="refnodt_supp1" />
                                <label for="refnodt_supp1">Ref. Date</label>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- /End Suggest Supplier 1 -->
            <br />

@{
    ViewData["Title"] = "Productivity Record Sheet";
    ViewData["navbarHideToggle"] = true;
    // *** No Menus ***
    ViewData["isMenu"] = false;
    ViewData["menuFixed"] = "";
    // *** No Navbar ***
    ViewData["isNavbar"] = false;
    ViewData["navbarType"] = "layout-navbar-hidden";

    // List<UserStockModel> useHr = new List<UserStockModel>();
    // useHr = Model.VMCosrUses;
    // List<WORoutingModel> woList = new List<WORoutingModel>();
    // woList = Model.VMWORouting;
    List<RoutingResourceModel> woDet = new List<RoutingResourceModel>();
    woDet = Model.VMRoutingResource;
    List<HRUserModel> useHr = new List<HRUserModel>();
    useHr = Model.VMHrUserModel;

    string strWo = "";
    if (ViewData["STRWO"] != null)
    {
        strWo = ViewData["STRWO"].ToString().Trim();
    }
    else
    {
        strWo = "";
    }
    string scrapid = "";
    if (ViewData["SCRAPID"] != null)
    {
        scrapid = ViewData["SCRAPID"].ToString().Trim();
    }
    string urlApprove = "";
    if (ViewData["URLAPPROVE"] != null)
    {
        urlApprove = ViewData["URLAPPROVE"].ToString().Trim();
    }
    decimal dQTY = 0;
    if (ViewData["PLANQTY"] != null)
    {
        dQTY = decimal.Parse(ViewData["PLANQTY"].ToString());
    }
}
@section PageStyles {
<link href="~/css/prdrecordsheet.css" rel="stylesheet" />
}
@section PageScripts {
<script src="~/js/jquery.min.js"></script>
<script src="~/js/jquery.js"></script>

<script src="~/js/datatables.min.js"></script>
<script src="~/js/datatables.js"></script>

<script src="~/js/prdrecordsheet.js"></script>

<script src="~/js/xlsx.full.min.js"></script>
<script src="~/js/jszip.min.js"></script>

}

    <!-- Add PR Detail -->
    <div class="card bt-card mb-3" id="card-detail">
      <h5 class="bt-subcard-header"><i class="ri-file-list-3-line"></i> Items Detail</h5>
      <div class="card-body">
          <div class="row border border-success p-2 text-success bg-body">
              <div class="col-md-2 p-2">
                  <strong>Request Items</strong>
              </div>
              <!-- Detail -->
              <div class="col-md-12 mb-3">
                  <table class="table table-hover tableListPrdetail" id="bindDataTable">
                      <thead>
                          <tr class="tableListPrdetail">
                              <th class="tableListPrdetail">BT No</th>
                              <th>Description/Spec</th>
                              <th>Brand/Model</th>
                              <th>Acc Code</th>
                              <th>Cost Dept</th>
                              <th>Quantity</th>
                              <th>Unit</th>
                              <th>Unit Price</th>
                              <th>Discount</th>
                              <th>Total amount</th>
                              <th>Action</th>
                          </tr>
                      </thead>
                      <tbody class="table-border-bottom-0">
                          <tr>
                              <td></td>
                              <td></td>
                              <td></td>
                              <td></td>
                              <td></td>
                              <td></td>
                              <td></td>
                              <td></td>
                              <td></td>
                              <td></td>
                              <td></td>
                          </tr>
                      </tbody>
                      <tfoot class="table-border-bottom-0">
                          <tr>

                              <td colspan="2"></td>
                              <td>Currency</td>
                              <td colspan="2">
                                    <span id="prcurrency" class="textBold"></span>
                                </td>
                              <td align="right" colspan="3">
                                    Discount &nbsp;&nbsp;&nbsp; <span id="spnDisc" class="textBold"></span>
                              </td>
                              <td>Total</td>
                                <td align="right" colspan="2"><span id="spnTotal" class="textBold"></span></td>
                            </tr>
                      </tfoot>
                  </table>
              </div>
          </div>
      </div>
    </div>
    <!-- /Detail PR list -->

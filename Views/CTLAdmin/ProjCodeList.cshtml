@{
    ViewData["Title"] = "Project code configuration";
}

@section PageStyles {
    <link href="~/css/datatables.min.css" rel="stylesheet" />
    <link href="~/css/datatables.css" rel="stylesheet" />
    <link href="~/css/projcodelist.css" rel="stylesheet" />
    <link href="~/css/bt-theme.css" rel="stylesheet" />
}

<div class="card bt-card mb-4">
    <div class="bt-page-header">
        <h5><i class="ri-folder-settings-line"></i> @ViewData["Title"]</h5>
        <input type="hidden" id="adminRole" value="@ViewData["UROLEADMIN"]" />
    </div>

    <div class="bt-form-panel" id="spanAdmin" style="display:none">
        <div class="bt-form-panel-label">Add / edit project code</div>
        <div class="row">
            <div class="col-md-3">
                <input class="form-control" type="hidden" id="ProjNoTmp" />
                <input class="form-control" type="text" id="ProjNo" placeholder="Proj No" />
            </div>
            <div class="col-md-3">
                <input class="form-control" type="text" id="ProjName" placeholder="Proj Name" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-danger mb-1" for="ActiveTo">Active to</label>
                <input type="date" class="form-control form-control-sm" name="ActiveTo" id="ActiveTo">
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 d-block">Status</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="ProjStat" id="ProjStat1" value="1" />
                    <label class="form-check-label" for="ProjStat1">Active</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="ProjStat" id="ProjStat2" value="2" />
                    <label class="form-check-label" for="ProjStat2">Closed</label>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-center gap-3">
                <button class="btn btn-bt-primary" type="button" id="btnSubmit">Add +</button>
                <div class="bt-action-icons">
                    <i id="btnProjEdit" class="ri-save-3-fill text-success" onclick="javascript:SaveEditAccount();" style="display:none" title="Edit"></i>
                    <i id="btnProjDel" class="ri-delete-bin-2-fill text-danger" onclick="javascript:DeleteProject();" style="display:none" title="Delete"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive text-nowrap">
        <table id="bindDataTable" class="table table-hover" width="100%">
            <caption class="visually-hidden">Project code configuration</caption>
            <thead>
                <tr>
                    <th>Project No</th>
                    <th>Project Name</th>
                    <th>Status</th>
                    <th>Active To</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- User permission warning modal -->
<div class="modal fade" id="modalAuth" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="authwarning" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="authwarning">User Permission</h5>
            </div>
            <div class="modal-body">
                You don't have this permission
            </div>
            <div class="modal-footer">
                <button type="button" id="btnModalClose" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/js/jquery.js"></script>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/projcodelist.js?v=1.0.1"></script>
}

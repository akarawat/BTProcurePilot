@{
    ViewData["Title"] = "Item part configuration";
}

@section PageStyles {
    <link href="~/css/datatables.min.css" rel="stylesheet" />
    <link href="~/css/datatables.css" rel="stylesheet" />
    <link href="~/css/itempartlist.css" rel="stylesheet" />
    <link href="~/css/bt-theme.css" rel="stylesheet" />
}
@section VendorScripts {
    <script src="~/js/jquery.js"></script>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.js"></script>
    <script src="~/js/datatables.min.js"></script>
}

<div class="card bt-card mb-4">
    <div class="bt-page-header">
        <h5><i class="ri-archive-line"></i> @ViewData["Title"]</h5>
        <input type="hidden" id="adminRole" value="@ViewData["UROLEADMIN"]" />
    </div>

    <div class="bt-form-panel" id="spanAdmin" style="display:none">
        <div class="bt-form-panel-label">Add / edit item part</div>
        <div class="row">
            <div class="col-md-3">
                <input class="form-control" type="hidden" id="itemnoTmp" />
                <input class="form-control" type="text" id="itemno" placeholder="Item No" />
            </div>
            <div class="col-md-5">
                <input class="form-control" type="text" id="itemname" placeholder="Item Name" />
            </div>
            <div class="col-md-2">
                <input class="form-control" type="text" id="itemdoc" placeholder="Item doc (Option)" />
            </div>
            <div class="col-md-2 d-flex align-items-center gap-3">
                <button class="btn btn-bt-primary" type="button" id="btnSubmit">Add +</button>
                <div class="bt-action-icons">
                    <i id="btnItemEdit" class="ri-save-3-fill text-success" onclick="javascript:SaveEditItem();" style="display:none" title="Edit"></i>
                    <i id="btnItemDel" class="ri-delete-bin-2-fill text-danger" onclick="javascript:DeleteItem();" style="display:none" title="Delete"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive text-nowrap">
        <table id="bindDataTable" class="table table-hover" width="100%">
            <caption class="visually-hidden">Item part configuration</caption>
            <thead>
                <tr>
                    <th>BT Item No</th>
                    <th>Item Name</th>
                    <th>Item Code (*Option)</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- User permission warning modal -->
<div class="modal fade" id="modalAuth" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="authwarning" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="authwarning">User Permission</h5>
            </div>
            <div class="modal-body">
                You don't have this permission
            </div>
            <div class="modal-footer">
                <button type="button" id="btnModalClose" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/js/itempartlist.js?v=1.0.0"></script>
}

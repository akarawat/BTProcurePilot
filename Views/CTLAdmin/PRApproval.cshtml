    // modelCurrency = Model.VMCurrencyModel;

    ViewData["Title"] = "Approval Purchase Request";

    string sDOC_NUMBER = ViewData["DOC_NUMBER"]?.ToString() ?? string.Empty;
    string sEMPCODE = Context.Session.GetString(SessionModel.EMPCODE) ?? string.Empty;
    string sDEPCODE = Context.Session.GetString(SessionModel.DEPCODE) ?? string.Empty;
    string sUEMAIL = Context.Session.GetString(SessionModel.UEMAIL) ?? string.Empty;
    string sUROLEADMIN = Context.Session.GetString(SessionModel.UROLEADMIN) ?? string.Empty;
    string sMAILGROUPADMIN = Context.Session.GetString(SessionModel.MAILGROUPADMIN) ?? string.Empty;
}

@* ************** Content ************** *@
@section PageStyles {
    <link href="~/css/datatables.min.css" rel="stylesheet" />
    <link href="~/css/datatables.css" rel="stylesheet" />
    <link href="~/css/prnewrequest.css" rel="stylesheet" />
    <link href="~/css/bt-theme.css" rel="stylesheet" />
}
@section VendorScripts {
    <script src="~/js/moment.min.js"></script>
    
}
<form method="post">
  <div class="card bt-card mb-4">
    <div class="bt-page-header">
        <h5><i class="ri-file-check-line"></i> Purchase Request (Approval Form)</h5>
        <span class="bt-page-header-tag" id="prno_preix_tag"></span>
    </div>
    <div class="card-body">
    <div class="row">
        <!-- Approx require -->
        <div class="col-md-8 mb-3">
          Status: <label class="form-label text-info" id="lblReqStatus">-</label> <br/>
          Last Update: <label class="form-label text-info" id="lblLastupdate">-</label>
        </div>
        <div class="col-md-4 mb-3">
            <div class="form-check">
                <input type="text" class="form-control form-control-sm border-danger" name="prno_preix" id="prno_preix" placeholder="PR Number (Auto running No.)" disabled>
                <input type="hidden" name="prno" id="prno"/>
                <input type="hidden" name="prno_draft" id="prno_draft" value="@sDOC_NUMBER" />
                <input type="hidden" name="empCode" id="empCode" value="@sEMPCODE" />
                <input type="hidden" name="reqDepCode" id="reqDepCode" value="@sDEPCODE" />
                <input type="hidden" name="LoginEmpEmail" id="LoginEmpEmail" value="@sUEMAIL" />
                <input type="hidden" name="sUROLEADMIN" id="sUROLEADMIN" value="@sUROLEADMIN" />
                <input type="hidden" name="sMAILGROUPADMIN" id="sMAILGROUPADMIN" value="@sMAILGROUPADMIN" />
                @* <input type="hidden" name="empCode" id="empCode" value="@sEMPCODE" />
                <input type="text" name="sMAILGROUPADMIN" id="sMAILGROUPADMIN" value="@sMAILGROUPADMIN" /> *@
                <input type="hidden" name="urlApprove" id="urlApprove" value="@ViewData["URLApproval"]" />
                <input type="hidden" name="urlResult" id="urlResult" value="@ViewData["URLResult"]" />
            </div>
            <div class="form-check">
                <label for="id_projno" class="form-label">Project Number</label> <label id="id_projno_lbl" class="form-label textBold"></label>
                <input class="form-control custom-number-btinfo" list="opt_projno" id="id_projno" name="id_projno" placeholder="Project Number" disabled>
            </div>
        </div>
    </div>
    <div class="row">
        <!-- Approx require -->
        <div class="col-md-4 mb-3">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="rdoApprox" id="rdoApprox" value="3" disabled>
                <label class="form-check-label" for="rdoApprox">Urgent-PO issue after receive PR 3 working days</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="rdoApprox" id="rdoApprox2" value="1" disabled>
                <label class="form-check-label" for="rdoApprox2">Normal-PO issue after receive PR 10 working days</label>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="form-check">
                <label class="form-check-label" for="approx_dt">Require delivery date</label>
                <input type="date" class="form-control form-control-sm" name="approx_dt" id="approx_dt" disabled>
            </div>
            <div class="form-check">
                <input type="text" class="form-control form-control-sm" name="InvNo" id="InvNo"
                       placeholder="Investment request / Credit request No." disabled>
            </div>
        </div>
        <div class="col-md-4 mb-3"></div>
    </div>
    <div class="row">
        <!-- Purpose -->
        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Purpose:</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="rdoPurpose" id="rdoPurpose1" value="1" checked="checked" onclick="javascript:SupPurpose(1)" disabled>
                <label class="form-check-label" for="rdoPurpose1">Order external 365 system</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="rdoPurpose" id="rdoPurpose2" value="2" onclick="javascript:SupPurpose(2)" disabled>
                <label class="form-check-label" for="rdoPurpose2">Order in the 365 system</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="rdoPurpose" id="rdoPurpose3" value="3" onclick="javascript:SupPurpose(3)" disabled>
                <label class="form-check-label" for="rdoPurpose3">Request quotation only</label>
            </div>
        </div>

        <!-- Reference -->
        <div class="col-md-4 mb-3">
          <div class="row">
              <div class="mb-3">
                <label class="form-label fw-bold">Reference:</label>
                    <input type="text" class="form-control" name="reference" id="reference" placeholder="Change No. / NCR No. / WO No. / Work Permit No." disabled>
              </div>
                <!-- Reason to order -->
              <div class="mb-3">
                  <label class="form-label fw-bold">Reason to order:</label>
                    <textarea class="form-control" name="reason" id="reason" rows="2" disabled></textarea>
                </div>
            </div>
        </div>

        <!-- Area for purchaser -->
        <div class="col-md-4 mb-3">
            <div class="border p-2 border-warning text-warning">
                <strong>Area for purchaser use only</strong>
                <div class="mb-2">
                    <label class="form-label small">Revision ครั้งที่ <label class="text-info" id="lblRevisionNo">0</label></label>
                </div>
                <div class="mb-2">
                    <label class="form-label small">PR Received date</label>
                    <input type="date" class="form-control form-control-sm" name="prReceivedDate" id="prReceivedDate" disabled="disabled">
                </div>
                <div>
                    <label class="form-label small">PO Number</label>
                    <input type="text" class="form-control form-control-sm" name="poNumber" id="poNumber" disabled="disabled">
                </div>
                
                  <div>
                      <input class="form-check-input" type="radio" name="rdoProcApp" id="rdoProcApp1" value="1" disabled>
                      <label class="form-check-label text-success" for="rdoProcApp1">Recieve PR.</label>
                      <br />
                      <input class="form-check-input" type="radio" name="rdoProcApp" id="rdoProcApp9" value="9" disabled>
                      <label class="form-check-label text-warning" for="rdoProcApp9">Reject PR. All approval</label>
                      <br />
                      <input class="form-check-input" type="radio" name="rdoProcApp" id="rdoProcApp7" value="7" disabled>
                      <label class="form-check-label text-warning" for="rdoProcApp7">Reject PR. To Requester</label>
                  </div>
                  <div>
                      <label class="form-label small">Procurement Remark</label>
                      <input type="text" class="form-control form-control-sm" name="procRemark" id="procRemark" disabled="disabled">
                  </div>
                <div>
                    <input class="form-check-input" type="radio" name="rdoQuoRtn" id="rdoQuoRtn0" value="0" disabled>
                    <label class="form-check-label" for="rdoQuoRtn0">Procure no quotation</label>
                    <br />
                    <input class="form-check-input" type="radio" name="rdoQuoRtn" id="rdoQuoRtn1" value="1" disabled>
                    <label class="form-check-label" for="rdoQuoRtn1">Procure send quotation</label>

                </div>
                <div id="divProcControl" style="display:none">
                    <br />
                    <span class="text-start"><label class="btn btn-secondary" id="btnSndQuotation" disabled>Send Quotation</label></span> 
                    <span class="text-end"><label class="btn btn-success" id="btnProcApprove" disabled>PROC. SAVE</label></span>
                  </div>
            </div>
        </div>
    </div>
    <!-- Start Suggest Supplier 1 -->
    <div class="card bt-card mb-3" id="card-supp1" style="display:none">
        <h5 class="bt-subcard-header"><i class="ri-truck-line"></i> Suggested Supplier 1</h5>
        <div class="card-body">
              <div class="row mb-3">
                  <div class="col-md-3 border-warning">
                        <input class="form-control custom-number-btinfo" list="opt_supp1" id="id_supp1" name="id_supp1" placeholder="Select Supplier" disabled>
                  </div>

                  <div class="col-md-5">
                      <input type="hidden" id="sucgid1" />
                      <input type="hidden" id="CURRCY" />
                        <input type="text" class="form-control bg-transparent" name="name_supp1" id="name_supp1" placeholder="Supplier name (Option)" disabled>
                  </div>
                  <div class="col-md-1"></div>
                  <div class="col-md-3">

                  </div>
              </div>
              <div class="row mb-3 bg-transparent">
                  <div class="col-md-3">
                        <input type="text" class="form-control bg-transparent" name="vc_supp1" id="vc_supp1" placeholder="V/C" disabled style="display:none">
                        <input type="text" class="form-control" name="contact_supp1" id="contact_supp1" placeholder="Contact" disabled>
                  </div>
                    <div class="col-md-5">
                        <input type="email" class="form-control" name="email_supp1" id="email_supp1" placeholder="E-Mail" disabled>
                  </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control" name="tel_supp1" id="tel_supp1" placeholder="Tel/Fax." disabled>
                  </div>
              </div>
              <div class="row mb-3">
                  <div class="col-md-12">
                        <input type="text" class="form-control" name="remark_supp1" id="remark_supp1" placeholder="Remark." disabled>
                        <input type="text" class="form-control" name="quoref_supp1" id="quoref_supp1" placeholder="Ref Quotation No." disabled style="display:none">
                        <div class="form-floating form-floating-outline mb-6" style="display:none">
                            <input class="form-control" type="date" id="refnodt_supp1" disabled />
                            <label for="refnodt_supp1">Ref. Date</label>
                        </div>
                  </div>
              </div>
        </div>
    </div>

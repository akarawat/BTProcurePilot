                      <div class="col-md-6">
                          <input type="file" id="file" name="file" class="form-control form-control-sm" onchange="forceUpload()" />
                          <div class="form-text">Max 2 MB</div>
                      </div>
                      <div class="col-md-2">
                          <button type="button" id="btnUpload" class="btn btn-primary btn-sm w-100">Upload</button>
                      </div>
                  </div>
              </form>

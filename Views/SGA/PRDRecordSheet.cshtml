</div> *@

<div class="row">
    <!-- แถวแรกใช้วิธี Merge -->
    <div class="col-md-8">

        <div class="card shadow-none bg-transparent mb-8">
            <h5 class="card-header">Productivity Record Sheet</h5>
            <div class="card-body demo-vertical-spacing demo-only-element">

            </div>
        </div>
        <!--Infomation-->
        <div class="card mb-4">
            <div class="row card-header">
                <div class="col-4">Item number
                    <h5><span id="det_itemno" class="textBold text-success">@ViewData["PLANITEMNO"]</span></h5>
                    <span id="urlApprove" style="display:none">@urlApprove</span>
                    <span id="scrap_id" style="display:none">@scrapid</span>
                </div>
                <div class="col-6">
                    Item name 
                    <h6><span id="det_itemno_info" class="textBold text-success">@ViewData["PLANITEMNAME"]</span></h6>
                </div>
                <div class="col-2">Quantity
                    <h6><span id="det_qty" class="textBold text-success">@dQTY</span></h6>
                </div>
            </div>

            <div class="row card-header">
                <div class="col-4">

                </div>
                <div class="col-8">
                    <div class="modal-footer">
                        <span id="adm_docrole" style="display:none">@ViewData["USR_ADMINDOC"]</span>
                        <span id="wo_status" style="display:none">@ViewData["WOSTAT"]</span>
                        <span id="opr_open" style="display:none">@ViewData["OPROPEN"]</span>
                        <span id="opr_close" style="display:none">@ViewData["OPRCLOSE"]</span>
                        <span id="doc_closed" style="display:none">@ViewData["DOCCLOSED"]</span>
                        <button class="btn btn-success" type="button" id="btnExport" style="display:none !important;">EXPORT</button>&nbsp;
                        <button type="button" id="btnCloseDoc" style="display:none !important;">OPEN</button>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Merged -->
    <div class="col-md-4">
        <div class="card mb-4">
            <h5 class="card-header">WORK ORDER NO.</h5>
            <div class="card-body demo-vertical-spacing demo-only-element">
                <div class="input-group">
                    <h1 class="display-4">
                        <span class="textDisplay" id="title_wo">@ViewData["WO-NO"]</span>
                    </h1>
                </div>

                <div class="input-group">
                    <h5 class="card-header">
                        <span id="id_emp_stock">@ViewData["EMPCODE"]</span>
                        <span id="id_emp_stock_disp">@ViewData["DISPNAME"]</span> <br/>
                        <span id="id_emp_stock_email">@ViewData["EUMAIL"]</span>
                    </h5>
                </div>

            </div>
        </div>
        <div class="card mb-4">
            @* <h5 class="card-header">History Records</h5>
            <div class="card-body demo-vertical-spacing demo-only-element">
                <div class="input-group">
                    <h5 class="card-header">
                      <span>Date</span> <span>DatQty.</span> <span>Time</span>
                    </h5>
                </div>

            </div> *@
        </div>
    </div>
</div>


@* Start Loop For Operation *@

@{
    if (woDet != null)
    {
        foreach (var rowWoDet in woDet)
        {
            decimal dStdByOpr = (dQTY / rowWoDet.oprRuntime);

            <!-- START DYNAMIC OPR  -->
            <div id="div_opr_@rowWoDet.oprQty.ToString()" style="display:block" class="row">
                <!--# Start Foreach Rows Grid And More By Operation rows-->
                <div class="card mb-8">
                    <div class="row card-header">
                        <div class="col-sm-4">
                            <span class="list-unstyled m-0 avatar-group d-flex align-items-center">
                                <img src="~/img/avatars/5.png" alt="Avatar" class="rounded-circle" width="22">
                                <img src="~/img/avatars/6.png" alt="Avatar" class="rounded-circle" width="22">
                                <img src="~/img/avatars/7.png" alt="Avatar" class="rounded-circle" width="22">
                                &nbsp;
                                Operation
                                <span class="textBold text-info">@rowWoDet.oprQty.ToString()</span>
                            </span>
                        </div>
                        <div class="col-sm-2">
                            Resources
                            <span id="det_workcenter_@rowWoDet.oprQty.ToString()" class="textBold text-info">@rowWoDet.oprCost</span>
                        </div>
                        <div class="col-sm-2">
                            Standard Time
                            @{
                              // หา EFF

                                decimal divMcTime = (dQTY * rowWoDet.mctime) / 1000;
                                //decimal divStdTime = (dQTY * dStdByOpr) / 1000;
                                decimal divStdTime = (dQTY / divMcTime);
                                decimal divLabTime = (dQTY * rowWoDet.oprRuntime) / 1000;
                            }
                            <span id="det_stdtime_@rowWoDet.oprQty.ToString()" class="textBold text-info">@divStdTime.ToString("0.00")</span>
                        </div>
                        <div class="col-sm-4">
                            Machine
                            <span id="det_mctime_@rowWoDet.oprQty.ToString()" class="textBold text-info">@divMcTime.ToString("0.00")</span>
                            Labor
                            <span id="det_labtime_@rowWoDet.oprQty.ToString()" class="textBold text-info">@divLabTime.ToString("0.00")</span>
                        </div>
                    </div>
                    <div class="card-body demo-vertical-spacing demo-only-element">
                        <div class="row">
                            <div class="col-sm-8">
                                <!-- Operation Keyin -->
                                <div class="table-responsive text-nowrap">
                                    <table class="table table-bordered tableTimeInfo">
                                        <thead class="trHeader">
                                            <tr>
                                                <td colspan="2">
                                                    Time Record (ข้อมูลบันทึกการลงเวลาของ Operation @rowWoDet.oprQty.ToString())
                                                </td>
                                                <td align="right">
                                                    @if (@rowWoDet.woitem_stat.ToString() == "0"){
                                                        @if (@rowWoDet.opr_stat.ToString() == "0")
                                                        {
                                                            <a href="javascript:SubmitTime('@rowWoDet.ID.ToString()',@rowWoDet.opr_stat.ToString());"><i class="ri-git-repository-commits-line text-warning me-1"></i>Submit time</a>
                                                        }
                                                        else
                                                        {
                                                            <a href="javascript:SubmitTime('@rowWoDet.ID.ToString()',@rowWoDet.opr_stat.ToString());"><i class="ri-git-repository-commits-line text-success me-1"></i>Submited</a>
                                                        }
                                                    }

                                                </td>
                                            </tr>
                                        </thead>
                                        <tbody class="tbodyInfo">
                                            <tr>
                                                <td colspan="3">
                                                    <table id="tabTask_@rowWoDet.oprQty.ToString()" class="display" style="width:100%">
                                                        <thead>
                                                            <tr>
                                                                <td class="txtDate">Date</td>
                                                                <td>Setup</td>
                                                                <td>M/C</td>
                                                                <td>LAB</td>
                                                                <td>"A" Qty</td>
                                                                <td>"A" Total</td>
                                                                <td>"NG" Qty</td>
                                                            </tr>
                                                        </thead>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <th class="col-sm-8" scope="row" align="right"></th>
                                                <td class="col-sm-2">
                                                    <a href="javascript:ViewTimeSheet(@rowWoDet.oprQty.ToString(), @divStdTime.ToString("0.00"));"><i class="ri-calendar-schedule-line text-info me-1"></i> +View</a>
                                                </td>
                                                <td class="col-sm-2">
                                                  @if(ViewData["WOSTAT"] != null)
                                                    {
                                                        if (ViewData["WOSTAT"].ToString().Trim() == "0" &&
                                                            @rowWoDet.opr_stat.ToString() == "0"){
                                                            <a href="javascript:AddTimeSheet(@dQTY.ToString("0.00"), @divStdTime.ToString("0.00"), '@rowWoDet.oprCost.ToString()', @rowWoDet.oprQty.ToString().Trim(),
                                                                @rowWoDet.setuptime, @divMcTime.ToString("0.00"), @divLabTime.ToString("0.00"));"><i class="ri-calendar-check-line text-success me-1"></i> +Add</a>
                                                        }
                                                    }
                                                    
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <!-- Scrap -->
                                <div class="table-responsive text-nowrap">
                                    <table class="table table-bordered tableTimeInfo">
                                        <thead class="trHeader">
                                            <tr>
                                                <td colspan="3">
                                                    Scrap Record (Operation @rowWoDet.oprQty.ToString()) * (W=Wait for approve, A=Appreoved)
                                                </td>
                                            </tr>
                                        </thead>
                                        <tbody class="tbodyInfo">
                                            <tr>
                                                <td colspan="3">
                                                    <table id="tabScrap_@rowWoDet.oprQty.ToString()" class="display" style="width:100%">
                                                        <thead>
                                                            <tr>
                                                                <td class="txtDate">Date</td>
                                                                <td>Production</td>
                                                                <td>Supplier</td>
                                                                <td>Approval</td>
                                                            </tr>
                                                        </thead>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <th scope="row" align="right">Scrap Record</th>
                                                <td>
                                                    <a href="javascript:ViewTimeSheetScrap(@rowWoDet.oprQty.ToString());"><i class="ri-calendar-schedule-line text-info me-1"></i> +View</a>
                                                </td>
                                                <td>
                                                    @if(ViewData["WOSTAT"] != null)
                                                    {
                                                        if (ViewData["WOSTAT"].ToString().Trim() == "0" &&
                                                            @rowWoDet.opr_stat.ToString() == "0")
                                                        {
                                                            <a href="javascript:AddTimeSheetScrap(@dQTY.ToString("0.00"), @dStdByOpr.ToString("0.00"), '@rowWoDet.oprCost.ToString()', @rowWoDet.oprQty.ToString().Trim(),
                                                              @rowWoDet.setuptime, @rowWoDet.mctime, @rowWoDet.oprRuntime);"><i class="ri-calendar-check-line text-success me-1"></i> +Add</a>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <!-- End of Operation Foreach loop -->
            </div>
            <!-- END DYNAMIC OPR -->
            
        }
    }
}
@* End Loop For Operation *@

